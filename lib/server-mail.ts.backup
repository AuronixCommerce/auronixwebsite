import nodemailer from 'nodemailer';
import { adminDb } from '@/lib/firebase-admin';

const SMTP_HOST =
  process.env.SMTP_HOST || 'smtp.gmail.com';

const SMTP_PORT = Number(
  process.env.SMTP_PORT || 587
);

const SMTP_USER =
  process.env.SMTP_USER ||
  'support.auronixcommerce@gmail.com';

const SMTP_PASSWORD =
  process.env.SMTP_PASSWORD || '';

const SUPPORT_EMAIL =
  process.env.SUPPORT_EMAIL ||
  'support.auronixcommerce@gmail.com';

const WEBSITE =
  process.env.AURONIX_WEBSITE ||
  'https://auronixcommerce.com';

const transporter = nodemailer.createTransport({
  host: SMTP_HOST,
  port: SMTP_PORT,
  secure: SMTP_PORT === 465,
  auth: {
    user: SMTP_USER,
    pass: SMTP_PASSWORD,
  },
});

export type EmailType =
  | 'contact'
  | 'supplier'
  | 'seller'
  | 'support'
  | 'password-reset'
  | 'application'
  | 'general';

export interface SendEmailOptions {
  to: string;
  subject: string;
  body: string;
  htmlBody?: string;
  type?: EmailType;
  name?: string;
  threadId?: string;
  inReplyTo?: string;
  references?: string[];
  relatedRecordId?: string;
  relatedRecordType?: string;
  aiGenerated?: boolean;
  automated?: boolean;
}

export interface SendEmailResult {
  success: true;
  messageId: string;
  threadId: string;
  to: string;
  subject: string;
}

function clean(value: unknown): string {
  return typeof value === 'string'
    ? value.trim()
    : '';
}

function escapeHtml(value: string): string {
  return value
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
}

function getFirstName(name?: string): string {
  const value = clean(name);

  if (!value) {
    return 'there';
  }

  return (
    value.split(/\s+/)[0] ||
    'there'
  );
}

function generateThreadId(): string {
  return `auronix-${Date.now()}-${Math.random()
    .toString(36)
    .slice(2, 10)}`;
}

function generateMessageId(): string {
  const domain =
    process.env.EMAIL_MESSAGE_DOMAIN ||
    'auronixcommerce.com';

  return `<${Date.now()}.${Math.random()
    .toString(36)
    .slice(2, 12)}@${domain}>`;
}

function createHtmlEmail(body: string): string {
  const paragraphs = body
    .split(/\n\s*\n/)
    .map((paragraph) => {
      const safe = escapeHtml(
        paragraph
      ).replace(/\n/g, '<br />');

      return `
        <p
          style="
            margin:0 0 18px;
            color:#333333;
            font-size:15px;
            line-height:1.75;
          "
        >
          ${safe}
        </p>
      `;
    })
    .join('');

  return `
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width,initial-scale=1"
    />
    <title>Auronix Commerce</title>
  </head>

  <body
    style="
      margin:0;
      padding:0;
      background:#f5f5f5;
      font-family:Arial,Helvetica,sans-serif;
      color:#111111;
    "
  >
    <div
      style="
        max-width:680px;
        margin:32px auto;
        background:#ffffff;
        border:1px solid #e8e8e8;
        border-radius:18px;
        overflow:hidden;
      "
    >
      <div
        style="
          padding:28px 32px;
          border-bottom:1px solid #eeeeee;
        "
      >
        <div
          style="
            font-size:19px;
            font-weight:700;
            letter-spacing:-0.2px;
          "
        >
          AURONIX
        </div>

        <div
          style="
            margin-top:4px;
            font-size:11px;
            letter-spacing:2px;
            text-transform:uppercase;
            color:#888888;
          "
        >
          Commerce LLC
        </div>
      </div>

      <div style="padding:32px;">
        ${paragraphs}
      </div>

      <div
        style="
          padding:24px 32px;
          border-top:1px solid #eeeeee;
          background:#fafafa;
        "
      >
        <div
          style="
            font-size:14px;
            font-weight:600;
          "
        >
          Auronix Commerce Team
        </div>

        <div
          style="
            margin-top:4px;
            font-size:13px;
            color:#666666;
          "
        >
          Auronix Commerce LLC
        </div>

        <div
          style="
            margin-top:10px;
            font-size:13px;
          "
        >
          <a
            href="mailto:${SUPPORT_EMAIL}"
            style="
              color:#111111;
              text-decoration:none;
            "
          >
            ${SUPPORT_EMAIL}
          </a>
        </div>

        <div
          style="
            margin-top:4px;
            font-size:13px;
          "
        >
          <a
            href="${WEBSITE}"
            style="
              color:#111111;
              text-decoration:none;
            "
          >
            ${WEBSITE}
          </a>
        </div>

        <div
          style="
            margin-top:16px;
            font-size:11px;
            color:#999999;
            line-height:1.6;
          "
        >
          This email was sent regarding your communication with Auronix Commerce LLC.
        </div>
      </div>
    </div>
  </body>
</html>
`.trim();
}

function normalizeReferences(
  references?: string[]
): string | undefined {
  if (!references?.length) {
    return undefined;
  }

  const values = references
    .map((value) => clean(value))
    .filter(Boolean);

  return values.length
    ? values.join(' ')
    : undefined;
}

async function saveEmailThread(options: {
  threadId: string;
  messageId: string;
  to: string;
  subject: string;
  body: string;
  type: EmailType;
  name?: string;
  relatedRecordId?: string;
  relatedRecordType?: string;
  aiGenerated?: boolean;
  automated?: boolean;
  inReplyTo?: string;
  references?: string[];
}): Promise<void> {
  try {
    const now = Date.now();

    const threadRef =
      adminDb.ref(
        `emailThreads/${options.threadId}`
      );

    const existing =
      await threadRef.get();

    if (!existing.exists()) {
      await threadRef.set({
        threadId:
          options.threadId,

        type:
          options.type,

        recipient:
          options.to,

        name:
          options.name || '',

        subject:
          options.subject,

        relatedRecordId:
          options.relatedRecordId || '',

        relatedRecordType:
          options.relatedRecordType || '',

        createdAt:
          now,

        updatedAt:
          now,
      });
    }

    const messageRef =
      threadRef
        .child('messages')
        .push();

    await messageRef.set({
      id:
        options.messageId,

      direction:
        'outbound',

      sender:
        SMTP_USER,

      recipient:
        options.to,

      subject:
        options.subject,

      body:
        options.body,

      type:
        options.type,

      aiGenerated:
        options.aiGenerated === true,

      automated:
        options.automated === true,

      inReplyTo:
        options.inReplyTo || '',

      references:
        options.references || [],

      createdAt:
        now,
    });

    await threadRef.update({
      updatedAt:
        now,

      lastMessageAt:
        now,

      lastDirection:
        'outbound',
    });
  } catch (error) {
    console.error(
      '[server-mail] Failed to save email thread:',
      error
    );
  }
}

export async function sendProfessionalEmail(
  options: SendEmailOptions
): Promise<SendEmailResult> {
  const to =
    clean(options.to);

  const subject =
    clean(options.subject);

  const body =
    clean(options.body);

  if (!to) {
    throw new Error(
      'Recipient email address is required.'
    );
  }

  if (!subject) {
    throw new Error(
      'Email subject is required.'
    );
  }

  if (!body) {
    throw new Error(
      'Email body is required.'
    );
  }

  if (!SMTP_PASSWORD) {
    throw new Error(
      'Email service is not configured.'
    );
  }

  const threadId =
    clean(options.threadId) ||
    generateThreadId();

  const messageId =
    generateMessageId();

  const html =
    options.htmlBody ||
    createHtmlEmail(body);

  const references =
    normalizeReferences(
      options.references
    );

  const info =
    await transporter.sendMail({
      from:
        `"Auronix Commerce Team" <${SMTP_USER}>`,

      to,

      replyTo:
        SUPPORT_EMAIL,

      subject,

      text:
        body,

      html,

      messageId,

      ...(options.inReplyTo
        ? {
            inReplyTo:
              options.inReplyTo,
          }
        : {}),

      ...(references
        ? {
            references,
          }
        : {}),
    });

  const actualMessageId =
    info.messageId ||
    messageId;

  await saveEmailThread({
    threadId,
    messageId:
      actualMessageId,
    to,
    subject,
    body,
    type:
      options.type ||
      'general',
    name:
      options.name,
    relatedRecordId:
      options.relatedRecordId,
    relatedRecordType:
      options.relatedRecordType,
    aiGenerated:
      options.aiGenerated,
    automated:
      options.automated,
    inReplyTo:
      options.inReplyTo,
    references:
      options.references,
  });

  return {
    success: true,
    messageId:
      actualMessageId,
    threadId,
    to,
    subject,
  };
}

