/* ============================================================
   SELLER INVITATION
   Supports BOTH:
   sendSellerInvitationEmail(email, name, url)
   and:
   sendSellerInvitationEmail({ to, name, activationUrl })
============================================================ */

export async function sendSellerInvitationEmail(
  toOrParams:
    | string
    | {
        to?: string;
        email?: string;
        name?: string;
        fullName?: string;
        activationUrl?: string;
        invitationUrl?: string;
        threadId?: string;
        relatedRecordId?: string;
        applicationId?: string;
      },
  nameOrActivationUrl?: string,
  activationUrlOrUndefined?: string
) {
  let to = '';

  let name = 'there';

  let activationUrl = '';

  let threadId:
    | string
    | undefined;

  let relatedRecordId:
    | string
    | undefined;

  if (
    typeof toOrParams ===
    'object'
  ) {
    const params =
      toOrParams;

    to =
      clean(
        params.to ||
          params.email
      );

    name =
      clean(
        params.name ||
          params.fullName
      ) || 'there';

    activationUrl =
      clean(
        params.activationUrl ||
          params.invitationUrl
      );

    threadId =
      clean(
        params.threadId
      ) || undefined;

    relatedRecordId =
      clean(
        params.relatedRecordId ||
          params.applicationId
      ) || undefined;
  } else {
    /*
     * Existing route:
     *
     * sendSellerInvitationEmail(
     *   application.email,
     *   application.fullName,
     *   invitationUrl
     * );
     */

    to =
      clean(
        toOrParams
      );

    name =
      clean(
        nameOrActivationUrl
      ) || 'there';

    activationUrl =
      clean(
        activationUrlOrUndefined
      );
  }

  if (!to) {
    throw new Error(
      'Seller email address is required.'
    );
  }

  if (!activationUrl) {
    throw new Error(
      'Seller activation URL is required.'
    );
  }

  const first =
    getFirstName(name);

  const subject =
    'Your Auronix Commerce Seller Account Is Ready';

  const body = `
Dear ${first},

We are pleased to let you know that your seller application with Auronix Commerce LLC has been reviewed and your account is ready for setup.

To complete your account, please use the secure link below:

${activationUrl}

During account setup, you will be able to establish your login credentials and complete the remaining onboarding information.

If you need help at any point, simply reply to this email and our support team can assist you. Please include your application or ticket information when possible so we can help you more efficiently.

If you did not submit an application to Auronix Commerce LLC, you may disregard this message and contact our support team.

We look forward to welcoming you to Auronix Commerce.

Kind regards,

Auronix Commerce Team
Auronix Commerce LLC
`.trim();

  return sendProfessionalEmail({
    to,
    name,
    subject,
    body,
    type:
      'seller',
    threadId,
    relatedRecordId,
    relatedRecordType:
      'seller-application',
    automated:
      true,
  });
}

