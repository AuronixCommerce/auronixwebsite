export async function sendApplicationUpdateEmail(
  params: {
    to: string;
    name?: string;
    subject: string;
    body: string;
    applicationId?: string;
    applicationType?:
      | 'seller'
      | 'supplier'
      | 'partner';
    threadId?: string;
    aiGenerated?: boolean;
  }
) {
  return sendProfessionalEmail({
    to:
      params.to,
    name:
      params.name,
    subject:
      params.subject,
    body:
      params.body,
    type:
      'application',
    threadId:
      params.threadId,
    relatedRecordId:
      params.applicationId,
    relatedRecordType:
      params.applicationType ||
      'application',
    aiGenerated:
      params.aiGenerated,
  });
}

/* ============================================================
   SELLER REJECTION
   Supports old positional and new object format.
============================================================ */

export async function sendSellerRejectionEmail(
  toOrParams:
    | string
    | {
        to?: string;
        email?: string;
        name?: string;
        fullName?: string;
        reason?: string;
        rejectionReason?: string;
        applicationId?: string;
        aiGenerated?: boolean;
        threadId?: string;
      },
  nameOrReason?: string,
  reasonOrApplicationId?: string,
  applicationId?: string
) {
  let to = '';

  let name = 'there';

  let reason =
    'The application did not meet the current requirements.';

  let actualApplicationId:
    | string
    | undefined;

  let threadId:
    | string
    | undefined;

  let aiGenerated = false;

  if (
    typeof toOrParams ===
    'object'
  ) {
    const params =
      toOrParams;

    to =
      clean(
        params.to ||
          params.email
      );

    name =
      clean(
        params.name ||
          params.fullName
      ) || 'there';

    reason =
      clean(
        params.reason ||
          params.rejectionReason
      ) || reason;

    actualApplicationId =
      params.applicationId;

    threadId =
      clean(
        params.threadId
      ) || undefined;

    aiGenerated =
      params.aiGenerated === true;
  } else {
    to =
      clean(
        toOrParams
      );

    /*
     * Supported old signatures:
     *
     * sendSellerRejectionEmail(
     *   email,
     *   name,
     *   reason
     * )
     *
     * sendSellerRejectionEmail(
     *   email,
     *   reason
     * )
     *
     * sendSellerRejectionEmail(
     *   email,
     *   name,
     *   reason,
     *   applicationId
     * )
     */

    if (
      reasonOrApplicationId
    ) {
      name =
        clean(
          nameOrReason
        ) || 'there';

      reason =
        clean(
          reasonOrApplicationId
        ) || reason;

      actualApplicationId =
        clean(
          applicationId
        ) || undefined;
    } else {
      reason =
        clean(
          nameOrReason
        ) || reason;
    }
  }

  const first =
    getFirstName(name);

  const subject =
    'Update Regarding Your Auronix Commerce Seller Application';

  const body = `
Dear ${first},

Thank you for your interest in becoming a seller with Auronix Commerce LLC.

After reviewing your application, we are unable to approve it at this time.

Reason for this decision:

${reason}

This decision does not necessarily prevent you from applying again. You may review the information submitted, address the issue identified above, and submit a new application where applicable.

If you need clarification or believe this decision was made in error, simply reply to this email and our support team will be happy to assist you.

Kind regards,

Auronix Commerce Team
Auronix Commerce LLC
`.trim();

  return sendApplicationUpdateEmail({
    to,
    name,
    subject,
    body,
    applicationId:
      actualApplicationId,
    applicationType:
      'seller',
    threadId,
    aiGenerated,
  });
}

/* ============================================================
   PASSWORD RESET
============================================================ */

export async function sendPasswordResetEmail(
  params: {
    to: string;
    name?: string;
    resetUrl: string;
  }
) {
  const first =
    getFirstName(
      params.name
    );

  const subject =
    'Reset Your Auronix Commerce Password';

  const body = `
Dear ${first},

We received a request to reset the password for your Auronix Commerce account.

Use the secure link below to choose a new password:

${params.resetUrl}

For your security, this link may expire after a limited period and should not be shared with anyone.

If you did not request a password reset, you can safely ignore this email. Your current password will remain unchanged.

If you need assistance, simply reply to this email and our support team will help you.

Kind regards,

Auronix Commerce Team
Auronix Commerce LLC
`.trim();

  return sendProfessionalEmail({
    to:
      params.to,
    name:
      params.name,
    subject,
    body,
    type:
      'password-reset',
    automated:
      true,
  });
}

/* ============================================================
   SMTP TEST
============================================================ */

export async function verifyMailConnection() {
  if (!SMTP_PASSWORD) {
    throw new Error(
      'SMTP_PASSWORD is not configured.'
    );
  }

  await transporter.verify();

  return {
    success: true,
    from:
      SMTP_USER,
    support:
      SUPPORT_EMAIL,
  };
}

/* ============================================================
   BACKWARD COMPATIBILITY:
   EXISTING TICKET RESPONSE ROUTES
============================================================ */

export async function sendTicketResponseEmail(
  toOrParams:
    | string
    | {
        to?: string;
        email?: string;
        name?: string;
        subject?: string;
        body?: string;
        response?: string;
        ticketId?: string;
        threadId?: string;
        inReplyTo?: string;
        references?: string[];
        aiGenerated?: boolean;
        automated?: boolean;
      },
  subject?: string,
  response?: string
) {
  if (
    typeof toOrParams === 'object'
  ) {
    const params =
      toOrParams;

    return sendSupportResponseEmail({
      to:
        String(
          params.to ||
            params.email ||
            ''
        ),

      name:
        params.name,

      subject:
        String(
          params.subject ||
            'Auronix Commerce Support'
        ),

      body:
        String(
          params.body ||
            params.response ||
            ''
        ),

      ticketId:
        params.ticketId,

      threadId:
        params.threadId,

      inReplyTo:
        params.inReplyTo,

      references:
        params.references,

      aiGenerated:
        params.aiGenerated,

      automated:
        params.automated,
    });
  }

  return sendProfessionalEmail({
    to:
      toOrParams,

    subject:
      subject ||
      'Auronix Commerce Support',

    body:
      response || '',

    type:
      'support',

    relatedRecordType:
      'support-ticket',
  });
}

/* ============================================================
   BACKWARD COMPATIBILITY:
   EXISTING PASSWORD RESET ROUTES
============================================================ */

export async function sendPasswordResetEmailLegacy(
  email: string,
  name: string,
  resetUrl: string
) {
  return sendProfessionalEmail({
    to: email,
    name: name,
    subject:
      'Reset Your Auronix Commerce Password',
    body: `
Dear ${getFirstName(name)},

We received a request to reset the password for your Auronix Commerce account.

Use the secure link below to choose a new password:

${resetUrl}

For your security, this link may expire after a limited period and should not be shared with anyone.

If you did not request a password reset, you can safely ignore this email. Your current password will remain unchanged.

If you need assistance, simply reply to this email and our support team will help you.

Kind regards,

Auronix Commerce Team
Auronix Commerce LLC
`.trim(),
    type: 'password-reset',
    automated: true,
  });
}
