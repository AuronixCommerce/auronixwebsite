{
  "rules": {
    "aioDeveloperAccounts": {
      ".read": false,
      ".write": false
    },
    "aioDeveloperBilling": {
      ".read": false,
      ".write": false,
      ".indexOn": [
        "hasPendingEvents"
      ]
    },
    "aioDeveloperKeys": {
      ".read": false,
      ".write": false
    },
    "aioDeveloperKeyIndex": {
      ".read": false,
      ".write": false
    },
    "aioDeveloperUsage": {
      ".read": false,
      ".write": false
    },
    "aioDeveloperInvoices": {
      ".read": false,
      ".write": false
    },
    "aioDeveloperInvoiceQueue": {
      ".read": false,
      ".write": false
    },
    "aioDeveloperRateLimits": {
      ".read": false,
      ".write": false
    },
    "aioDeveloperRequestClaims": {
      ".read": false,
      ".write": false,
      ".indexOn": [
        "expiresAt"
      ]
    },
    "settings": {
      "aioDeveloperApi": {
        ".read": false,
        ".write": false
      }
    },
    "aioDeveloperPaymentReferences": {
      ".read": false,
      ".write": false
    },
    "aioDeveloperWebhooks": {
      ".read": false,
      ".write": false
    },
    "aioDeveloperEvents": {
      ".read": false,
      ".write": false,
      "$uid": {
        ".indexOn": [
          "createdAt"
        ]
      }
    },
    "aioDeveloperEventQueue": {
      ".read": false,
      ".write": false,
      ".indexOn": [
        "nextAttemptAt"
      ]
    },
    "aioApiNotices": {
      ".read": false,
      ".write": false
    }
  }
}
